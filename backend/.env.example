# ---------------------------------------------------------------------------
# Onushondhan backend (Laravel 12). Copy to .env and fill secrets from your
# secret manager. NEVER commit a filled-in .env. See docs/ENVIRONMENT.md.
# ---------------------------------------------------------------------------
APP_NAME=Onushondhan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Public origin of the site (the Next.js frontend and the API share it in
# production; Nginx routes /api, /sanctum, /admin to Laravel).
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# Public API, emails and notifications default to Bangla; the admin panel uses APP_LOCALE.
API_LOCALE=bn
USER_LOCALE=bn
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onushondhan
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production (HTTPS only)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Comma-separated host[:port] list whose browser requests get cookie (SPA) auth.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Reverse proxies trusted for X-Forwarded-* (add your CDN/load balancer if any).
TRUSTED_PROXIES=127.0.0.1,::1
# Shared secret with the frontend server (same value in frontend INTERNAL_API_TOKEN).
INTERNAL_API_TOKEN=
# Comma-separated origins allowed by CORS (only needed if the SPA calls the API cross-origin).
CORS_ALLOWED_ORIGINS=http://localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Private evidence / tip attachment storage. Must be outside any web root.
# Leave empty to use storage/app/private/vault.
VAULT_DISK=vault
VAULT_ROOT=
EVIDENCE_MAX_UPLOAD_MB=100
TIP_ATTACHMENT_MAX_MB=20

# Malware scanning: none | clamav. With "none", files are marked not_scanned.
MALWARE_SCANNER=none
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
CLAMAV_BINARY=/usr/bin/clamdscan
# When true, public evidence is only served once a scanner has marked it clean.
EVIDENCE_REQUIRE_CLEAN_SCAN=false

# Admin panel (Filament) — TOTP 2FA is enforced when true. Keep true in production.
ADMIN_MFA_REQUIRED=true

# Analytics privacy: HMAC key for daily-rotating anonymous visitor fingerprints.
# Generate with: php -r "echo base64_encode(random_bytes(32));"
ANALYTICS_FINGERPRINT_KEY=
ANALYTICS_RETENTION_DAYS=180
LOGIN_LOG_RETENTION_DAYS=365

# SMS provider for optional phone verification: log (dev) — integrate a real
# provider by binding App\Contracts\SmsSender.
SMS_DRIVER=log

MAIL_MAILER=log
# With MAIL_MAILER=log, write emails to storage/logs/mail.log (dev/E2E only).
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
