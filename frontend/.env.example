# Onushondhan frontend (Next.js). Only NEXT_PUBLIC_* values reach the browser —
# never put secrets in them.

# Where the Next.js server reaches Laravel (server-side fetches + /api rewrites).
API_INTERNAL_URL=http://127.0.0.1:8000

# Canonical public origin of the site (used for canonical URLs, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel URL shown to staff (Filament). In production: https://<domain>/admin
NEXT_PUBLIC_ADMIN_URL=http://localhost:8000/admin
