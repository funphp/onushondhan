# Onushondhan frontend (Next.js). Only NEXT_PUBLIC_* values reach the browser —
# never put secrets in them.

# Where the Next.js server reaches Laravel (server-side fetches + /api rewrites).
# Production: http://127.0.0.1:8080 (the internal-only Nginx listener, see deploy/nginx).
API_INTERNAL_URL=http://127.0.0.1:8000

# Shared secret with the backend (INTERNAL_API_TOKEN) so server-side renders are not
# rate-limited as a single client. Server-only — never prefix with NEXT_PUBLIC_.
INTERNAL_API_TOKEN=

# Canonical public origin of the site (used for canonical URLs, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel URL shown to staff (Filament). In production: https://<domain>/admin
NEXT_PUBLIC_ADMIN_URL=http://localhost:8000/admin

# Google Analytics 4 / Google AdSense — optional, public ids only (baked in at build time,
# so rebuild after changing). Leave empty to disable; the CSP only allows Google hosts
# for the services configured here. See docs/ANALYTICS_ADS.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
