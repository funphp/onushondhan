# Production backend environment → /var/www/onushondhan/shared/backend.env (chmod 600, owner onushondhan).
# Replace every <...>; secrets come from your secret manager. Never commit the filled-in file.
APP_NAME=Onushondhan
APP_ENV=production
APP_KEY=<php artisan key:generate --show>
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://<domain>
FRONTEND_URL=https://<domain>

# Admin panel language (English). The public API/emails use API_LOCALE / USER_LOCALE.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
API_LOCALE=bn
USER_LOCALE=bn

HASH_DRIVER=argon2id
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onushondhan
DB_USERNAME=<app-user>
DB_PASSWORD=<secret>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=<domain>
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=127.0.0.1,::1

# Same random value as INTERNAL_API_TOKEN in frontend.env: php -r "echo bin2hex(random_bytes(32));"
INTERNAL_API_TOKEN=<secret>

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

VAULT_DISK=vault
VAULT_ROOT=/var/www/onushondhan/shared/storage/app/private/vault
EVIDENCE_MAX_UPLOAD_MB=100
TIP_ATTACHMENT_MAX_MB=20

MALWARE_SCANNER=clamav
CLAMAV_BINARY=/usr/bin/clamdscan
EVIDENCE_REQUIRE_CLEAN_SCAN=true

ADMIN_MFA_REQUIRED=true
ANALYTICS_FINGERPRINT_KEY=<php -r "echo base64_encode(random_bytes(32));">
ANALYTICS_RETENTION_DAYS=180
LOGIN_LOG_RETENTION_DAYS=365
SMS_DRIVER=log
SEED_DEMO_DATA=false

MAIL_MAILER=smtp
MAIL_SCHEME=<smtp|smtps>
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<secret>
MAIL_FROM_ADDRESS=no-reply@<domain>
MAIL_FROM_NAME="${APP_NAME}"
