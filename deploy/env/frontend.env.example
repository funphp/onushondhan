# Production frontend environment → /var/www/onushondhan/shared/frontend.env (chmod 600, owner onushondhan).
# Used both when deploy.sh builds the app (NEXT_PUBLIC_* and the /api rewrites are baked in) and
# by the onushondhan-next systemd unit at runtime, so build and runtime always agree.
API_INTERNAL_URL=http://127.0.0.1:8080
INTERNAL_API_TOKEN=<same secret as backend.env>
NEXT_PUBLIC_SITE_URL=https://<domain>
NEXT_PUBLIC_ADMIN_URL=https://<domain>/admin
