# Claude: adapt this template to the actual deployment paths/domain.
server {
    listen 80;
    server_name example.com;

    # Laravel API/public assets only.
    root /var/www/onushondhan/backend/public;
    index index.php;

    location /api/ {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location /storage/ {
        # Only intentionally public storage should be exposed here.
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
