[Unit]
Description=Onushondhan Next.js frontend
After=network.target

[Service]
Type=simple
User=onushondhan
Group=onushondhan
WorkingDirectory=/var/www/onushondhan/current/frontend/.next/standalone
# Same file deploy.sh builds with, so baked-in and runtime settings cannot drift.
EnvironmentFile=/var/www/onushondhan/shared/frontend.env
Environment=NODE_ENV=production HOSTNAME=127.0.0.1 PORT=3000
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/onushondhan/current/frontend/.next/standalone/.next/cache

[Install]
WantedBy=multi-user.target
