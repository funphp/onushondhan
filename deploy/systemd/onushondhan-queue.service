[Unit]
Description=Onushondhan Laravel queue worker (database driver)
After=network.target mysql.service

[Service]
Type=simple
User=onushondhan
Group=onushondhan
WorkingDirectory=/var/www/onushondhan/current/backend
ExecStart=/usr/bin/php artisan queue:work database --sleep=3 --tries=3 --timeout=300 --max-time=3600
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
